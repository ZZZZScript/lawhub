-- Input Radius
local typing = false
local inputConnection

RadiusText.MouseButton1Click:Connect(function()
    if typing then return end
    
    typing = true
    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, 0, 1, 0)
    textBox.Position = UDim2.new(0, 0, 0, 0)
    textBox.BackgroundTransparency = 1
    textBox.Text = tostring(AUTO_STEAL_PROX_RADIUS)
    textBox.Font = Enum.Font.GothamBold
    textBox.TextSize = 13
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.ClearTextOnFocus = false
    textBox.TextStrokeTransparency = 1
    textBox.Parent = RadiusFrame
    
    textBox:CaptureFocus()
    
    inputConnection = textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local num = tonumber(textBox.Text)
            if num and num >= 5 and num <= 200 then
                AUTO_STEAL_PROX_RADIUS = math.floor(num)
                updateCircleRadius()
                RadiusText.Text = tostring(AUTO_STEAL_PROX_RADIUS)
            end
        end
        
        textBox:Destroy()
        typing = false
        inputConnection:Disconnect()
    end)
end)

-- Atualização da Barra de Progresso
local progressTween = nil

task.spawn(function()
    while task.wait(0.03) do
        if not typing then
            RadiusText.Text = tostring(AUTO_STEAL_PROX_RADIUS)
        end
        
        if IsStealing then
            if progressTween then
                progressTween:Cancel()
            end
            
            progressTween = TweenService:Create(
                ProgressFill,
                TweenInfo.new(0.1, Enum.EasingStyle.Linear),
                {Size = UDim2.new(StealProgress, 0, 1, 0)}
            )
            progressTween:Play()
        else
            if progressTween then
                progressTween:Cancel()
                progressTween = nil
            end
            
            if ProgressFill.Size.X.Scale > 0 then
                ProgressFill.Size = UDim2.new(
                    math.max(0, ProgressFill.Size.X.Scale - 0.03), 
                    0, 
                    1, 
                    0
                )
            end
        end
    end
end)

-- Teclas de Atalho
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        toggleSemi()
    elseif input.KeyCode == Enum.KeyCode.Equals or input.KeyCode == Enum.KeyCode.KeypadPlus then
        currentSpeed = math.min(currentSpeed + 5, 50)
        updateSpeedUI()
    elseif input.KeyCode == Enum.KeyCode.Minus or input.KeyCode == Enum.KeyCode.KeypadMinus then
        currentSpeed = math.max(currentSpeed - 5, 20)
        updateSpeedUI()
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
        RadiusFrame.Visible = MainFrame.Visible
    end
end)

-- Drag do Menu
local dragging = false
local dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

MainFrame.InputEnded:Connect(function()
    dragging = false
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

