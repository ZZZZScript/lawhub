-- ==================== SPEED HACK SYSTEM ====================
local currentSpeed = 23
local speedBoostEnabled = false
local stealBoostEnabled = false
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

local function updateSpeed()
    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0.1 then
        local finalSpeed = currentSpeed
        
        if speedBoostEnabled then
            finalSpeed = finalSpeed * 1.8
        end
        if stealBoostEnabled then
            finalSpeed = finalSpeed * 2.2
        end
        
        local newVel = moveDir * finalSpeed
        root.AssemblyLinearVelocity = Vector3.new(newVel.X, newVel.Y, newVel.Z)
    end
end

RunService.Heartbeat:Connect(updateSpeed)

